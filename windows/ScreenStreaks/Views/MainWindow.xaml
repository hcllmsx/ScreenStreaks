<Window x:Class="ScreenStreaks.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ScreenStreaks"
        Width="456"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        ShowInTaskbar="True"
        Topmost="False"
        WindowStartupLocation="CenterScreen"
        FontFamily="Microsoft YaHei UI, Segoe UI"
        UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal">

    <!-- 整个窗口都可以拖动：挂在根 Border 上，
         按钮/滑杆/开关这些控件会自己把事件标记为已处理，不会误触发拖动 -->
    <Border Background="{StaticResource BgBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="14"
            Padding="22,20,22,20"
            MouseLeftButtonDown="OnWindowDrag">

        <StackPanel>

            <!-- ============ 顶部标题 ============ -->
            <Grid>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left">
                    <Grid Width="36" Height="36">
                        <!-- 首选：程序图标（入库的 Assets/app.png） -->
                        <Image x:Name="LogoImage"
                               Visibility="Collapsed"
                               RenderOptions.BitmapScalingMode="HighQuality" />

                        <!-- 白色描边。
                             图标 PNG 自带的边框宽度是随尺寸缩放的（2.6 * size/256），
                             在 256px 下有 2.6px，但界面里显示成 36px 时只剩约 0.37px ——
                             亚像素，渲染出来几乎看不见。所以这里另加一条真正可见的白边。

                             Margin / CornerRadius 是按图标 PNG 的透明边距与圆角推算的：
                               透明边距 14/256 * 36 ≈ 2px
                               圆角     46/256 * 36 ≈ 6.5px
                             图标源文件的留白与圆角若改动，这两个值要跟着调。 -->
                        <Border x:Name="LogoFrame"
                                Margin="2"
                                CornerRadius="6.5"
                                BorderBrush="#FFFFFFFF"
                                BorderThickness="1.4"
                                IsHitTestVisible="False"
                                Visibility="Collapsed" />

                        <!-- 兜底：图标资源缺失时显示字母徽标。
                             图标虽然已入库，但 csproj 按 Exists 条件包含它，
                             删掉文件就不会打进程序集，所以这里不能假设它一定存在 ——
                             否则会连主面板都构造不出来。 -->
                        <Border x:Name="LogoFallback"
                                CornerRadius="10"
                                Background="{StaticResource SurfaceAltBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="1">
                            <TextBlock Text="S"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="ScreenStreaks" Style="{StaticResource TitleText}" />
                        <TextBlock x:Name="TaglineText" Style="{StaticResource CaptionText}" Margin="0,3,0,0" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                    <Border Background="{StaticResource SurfaceAltBrush}"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="8,3"
                            VerticalAlignment="Center">
                        <TextBlock x:Name="VersionText"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   FontSize="11" />
                    </Border>
                    <Button Content="✕"
                            Style="{StaticResource GhostButton}"
                            Padding="9,5"
                            Margin="8,0,0,0"
                            ToolTip="最小化到托盘"
                            Click="OnCloseClick" />
                </StackPanel>
            </Grid>

            <!-- ============ 当前状态 ============ -->
            <Border Style="{StaticResource Card}" Margin="0,20,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Ellipse x:Name="StatusDot"
                                 Width="9" Height="9"
                                 Fill="{StaticResource TextMutedBrush}"
                                 VerticalAlignment="Center" />
                        <TextBlock x:Name="StatusText"
                                   Style="{StaticResource LabelText}"
                                   FontWeight="SemiBold"
                                   Margin="10,0,0,0" />
                    </StackPanel>

                    <TextBlock x:Name="RegionText" Style="{StaticResource CaptionText}" Margin="0,11,0,0" />
                    <TextBlock x:Name="HotkeyText" Style="{StaticResource CaptionText}" Margin="0,6,0,0" />
                </StackPanel>
            </Border>

            <!-- ============ 主操作 ============ -->
            <Button x:Name="SelectButton"
                    Content="开始框选区域"
                    Style="{StaticResource PrimaryButton}"
                    Padding="16,13"
                    FontSize="14"
                    Margin="0,16,0,0"
                    Click="OnSelectClick" />

            <Button x:Name="DisplayButton"
                    Content="进入展示态"
                    Style="{StaticResource BaseButton}"
                    Padding="16,11"
                    Margin="0,10,0,0"
                    Click="OnDisplayClick" />

            <!-- ============ 选项 ============ -->
            <Border Style="{StaticResource Card}" Margin="0,16,0,0">
                <StackPanel>
                    <CheckBox x:Name="AutoStartToggle"
                              Style="{StaticResource ToggleSwitch}"
                              Content="开机自动启动"
                              Click="OnAutoStartClick" />
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,10,0,0"
                               Text="开机静默进入展示态，不会弹出本面板。" />
                </StackPanel>
            </Border>

            <!-- ============ 底部 ============ -->
            <!-- 三个元素同处一格：左对齐 / 居中 / 右对齐，自然排成一行 -->
            <Grid Margin="0,16,0,0">
                <Button Content="设置"
                        Style="{StaticResource GhostButton}"
                        HorizontalAlignment="Left"
                        MinWidth="88"
                        Click="OnSettingsClick" />

                <Button x:Name="AuthorLink"
                        Style="{StaticResource LinkButton}"
                        Content="by 火车啦啦"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        ToolTip="在浏览器中打开作者主页"
                        Click="OnAuthorClick" />

                <Button Content="退出程序"
                        Style="{StaticResource DangerButton}"
                        HorizontalAlignment="Right"
                        MinWidth="96"
                        Click="OnExitClick" />
            </Grid>

        </StackPanel>
    </Border>
</Window>
